{
  "name": "@codedroid/mcp",
  "version": "0.1.1",
  "description": "MCP server for controlling Android devices through CodeDroid from Claude Code, Codex, Gemini CLI, and other MCP clients.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "codedroid-mcp": "src/index.js"
  },
  "files": [
    "src",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    ".agents/plugins/marketplace.json",
    "gemini-extension.json",
    ".mcp.json",
    "README.md",
    "LICENSE.aura-mcp-connect"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.22.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "android",
    "adb",
    "websocket",
    "claude-code",
    "codex",
    "codedroid"
  ],
  "homepage": "https://get.codedroid.com",
  "scripts": {
    "test": "for f in src/*.js; do node --check \"$f\" || exit 1; done && for t in test/*.test.mjs; do node \"$t\" || exit 1; done"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codedroid-team/codedroid-mcp.git"
  }
}
