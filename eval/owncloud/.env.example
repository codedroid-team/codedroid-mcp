# Copy to .env and fill in. .env is gitignored; never commit it.
# Domain the phone uses to reach the server: <laptop LAN IP>:8080
OWNCLOUD_DOMAIN=localhost:8080
# Comma-separated; must include the laptop LAN IP the phone connects to
OWNCLOUD_TRUSTED_DOMAINS=localhost,192.0.2.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Password of the test user "e2e" created by seed.sh
E2E_PASSWORD=change-me
