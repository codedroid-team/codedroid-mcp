# Copy to .env and fill in. .env is gitignored; never commit it.
# The laptop LAN IP and port, as the phone types it (for example 192.0.2.1:8080)
OWNCLOUD_DOMAIN=192.0.2.1:8080
# Comma-separated; must include the laptop LAN IP the phone connects to, and localhost for seed.sh
OWNCLOUD_TRUSTED_DOMAINS=localhost,192.0.2.1
ADMIN_USERNAME=admin
# Generate with: openssl rand -hex 12
ADMIN_PASSWORD=
# Password of the test user "e2e" created by seed.sh. Generate with: openssl rand -hex 12
E2E_PASSWORD=
